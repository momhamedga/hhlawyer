NODE_ENV=development
PORT=4000
# Comma-separated allowed browser origins. Each value must be an exact HTTP(S) origin.
WEB_ORIGIN=http://localhost:3000
BUSINESS_TIME_ZONE=Asia/Dubai
TRUST_PROXY=0
AUTH_SECRET=replace-with-a-32-character-minimum-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_ENABLED=false
# Set these only when EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_placeholder
EMAIL_FROM=notifications@example.com
CONTACT_NOTIFICATION_TO=notifications@example.com,backup@example.com

# Main / Development Neon Branch
DATABASE_URL="postgresql://USER:PASSWORD@MAIN_BRANCH_HOST/DATABASE?sslmode=require"

# Isolated Neon Test Branch
DATABASE_URL_TEST="postgresql://USER:PASSWORD@TEST_BRANCH_HOST/DATABASE?sslmode=require"
